{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude++",
  "version": "0.1.49",
  "identifier": "dev.claude-plus-plus.desktop",
  "build": {
    "beforeBuildCommand": "npm run verify:production",
    "frontendDist": "../../../ui/cyber-console"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Claude++ Control Tower",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "publisher": "Claude++",
    "category": "DeveloperTool",
    "shortDescription": "Claude Desktop enhancement control tower",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
